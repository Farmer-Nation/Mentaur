{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff",
  "type": "object",
  "required": ["id", "from", "to", "type", "claim", "evidence", "confidence", "label"],
  "properties": {
    "id": {"type": "string"},
    "time": {"type": "string"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "type": {"enum": ["finding", "hypothesis", "plan", "result", "approval", "decision"]},
    "refs": {"type": "array", "items": {"type": "string"}},
    "claim": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["low", "med", "high"]},
    "label": {"const": "agent-generated"}
  }
}
