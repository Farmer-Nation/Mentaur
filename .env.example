# --- ElevenLabs Agents Platform ---
# Get this from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Filled in automatically by `npm run create-agents`. You can also create the
# two agents by hand at elevenlabs.io/app/agents (see scripts/create-agents.ts
# for the system prompts + client tools to paste in) and set these yourself.
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

# Which LLM elevenlabs.io/app/agents should run behind the agents. See
# elevenlabs.io/docs/agents-platform/customization/llm for valid ids.
ELEVENLABS_LLM=claude-sonnet-4-5

# --- Vision + Work Map synthesis ---
# Anthropic API key, used for (a) diffing screen frames into events and
# (b) merging a session's events/transcript into the Work Map JSON.
ANTHROPIC_API_KEY=

# Optional overrides — any Claude model with vision support works for the
# first, any Claude model works for the second.
ANTHROPIC_VISION_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
