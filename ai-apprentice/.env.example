# Copy to .env and load with:  node --env-file=.env server/index.js
# Leave everything blank to run in MOCK mode (no keys needed).

PORT=8787

# ---- Vision (screen frame -> events). Enables "vision" mode. ----
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-5

# ---- Voice (ElevenLabs). Enables ElevenAgents + server-side TTS. ----
# Create an agent at https://elevenlabs.io/app/conversational-ai
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
