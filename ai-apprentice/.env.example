# Copy to .env and load with:  node --env-file=.env server/index.js
# Leave keys blank to run in keyless demo mode.

PORT=8787

# ---- Claude vision + reasoning ----
# Haiku is the default to keep hackathon API spend low. Override if your
# Anthropic account/model availability differs.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5
REASONING_MODEL=claude-haiku-4-5

# Browser checks visual activity every ~1.5s. Changed frames can reach Claude at
# this cadence; 4s keeps the live activity log and learner prompts responsive.
# Raise it to reduce vision spend.
VISION_INTERVAL_MS=4000

# Live coaching cadence. Activity summaries are persisted in room chat, suggested
# learner questions refresh from the latest compact Claude state, and Mentaur asks
# a spoken Guide question after the learner has been quiet for this long.
ACTIVITY_SUMMARY_INTERVAL_MS=60000
SUGGESTION_REFRESH_MS=6000
IDLE_QUESTION_MS=15000
IDLE_QUESTION_COOLDOWN_MS=18000

# ---- Voice ----
# ElevenLabs TTS is preferred whenever ELEVENLABS_API_KEY is present.
# If it is missing or a TTS request/playback fails, the client uses local browser TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional: use a different ElevenLabs voice for Japanese/Vietnamese speech.
# Falls back to ELEVENLABS_VOICE_ID when unset.
ELEVENLABS_VOICE_ID_JA=
ELEVENLABS_VOICE_ID_VI=

# Optional: retained for ElevenAgents experimentation / signed URL endpoint.
ELEVENLABS_AGENT_ID=

# ---- Bright Data Scraping Browser (chatbot "scrape a URL" widget) ----
# Format: wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222
# Leave blank to disable the scrape widget's backend (the button still shows,
# requests just return a "not configured" message).
BRIGHTDATA_WS_ENDPOINT=
BRIGHTDATA_TIMEOUT_MS=90000

# ---- Supabase auth + persistent knowledge base ----
# Required for sign-up/login and teacher/learner knowledge persistence.
# The anon key is used only by the Node server in this implementation; the
# service-role key MUST remain server-side and must never be placed in web/.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set true behind HTTPS in production. NODE_ENV=production also enables Secure cookies.
COOKIE_SECURE=false
# Active rooms are snapshotted at most once per minute, plus forced saves at key milestones.
KNOWLEDGE_PERSIST_INTERVAL_MS=60000
